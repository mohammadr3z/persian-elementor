{% if 'videohash/' in settings.aparat_url %}
  {% set hash = (settings.aparat_url | split('videohash/') | last | split('/') | first) %}
{% elseif '/v/' in settings.aparat_url %}
  {% set hash = (settings.aparat_url | split('/v/') | last | split('/') | first | split('?') | first) %}
{% else %}
  {% set hash = (settings.aparat_url | split('/') | last | split('?') | first) %}
{% endif %}

{% set query_params = [] %}
{% if settings.title_show_aparat %}
  {% set query_params = query_params | merge(['titleShow=true']) %}
{% endif %}
{% if settings.mute_aparat %}
  {% set query_params = query_params | merge(['muted=true']) %}
{% endif %}
{% if settings.autoplay %}
  {% set query_params = query_params | merge(['autoplay=true']) %}
{% else %}
  {% set query_params = query_params | merge(['autoplay=false']) %}
{% endif %}
{% set start_time = (settings.start_m | default(0) | abs * 60) + (settings.start_s | default(0) | abs) %}
{% if start_time > 0 %}
  {% set query_params = query_params | merge(['t=' ~ start_time]) %}
{% endif %}
{% if settings.recom_self %}
  {% set query_params = query_params | merge(['recom=self']) %}
{% endif %}

{% set query_string = query_params | join('&') %}
{% set iframe_src = 'https://www.aparat.com/video/video/embed/videohash/' ~ hash ~ '/vt/frame' %}
{% if query_string is not empty %}
  {% set iframe_src = iframe_src ~ '?' ~ query_string %}
{% endif %}

<style>
    .h_iframe-aparat_embed_frame {
        position: relative;
        overflow: hidden;
        width: 100%;
    }
    .h_iframe-aparat_embed_frame .ratio {
        display: block;
        width: 100%;
        height: auto;
    }
    .h_iframe-aparat_embed_frame iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: 0;
    }
    body.elementor-editor-active .h_iframe-aparat_embed_frame iframe {
        pointer-events: none;
    }
</style>
{%- set classes = settings.classes | merge( [ base_styles.base, 'h_iframe-aparat_embed_frame' ] ) | join(' ') | trim %}
{%- set id_attribute = settings._cssid is not empty ? 'id=' ~ settings._cssid | e('html_attr') : '' %}

<div {{ id_attribute }} class="{{ classes }}" {{ settings.attributes | raw }}>
    <span style="display: block; padding-top: 57%"></span>
    <iframe src="{{ iframe_src }}" allow="autoplay" allowFullScreen="true" webkitallowfullscreen="true" mozallowfullscreen="true"></iframe>
</div>
